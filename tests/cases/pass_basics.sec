// EXPECT-OUT: 42 -7 3 1
// EXPECT-OUT: 255 0 true false
// EXPECT-OUT: 2147483647 -2147483648 18446744073709551615
// EXPECT-OUT: 1.5 3 0.1
// EXPECT-OUT: 120 7 -3
const LIMIT: i32 = 10 * 4 + 2;
const NEG: i64 = -9223372036854775807 - 1;
fn fact(n: u64) -> u64 { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn main() -> i32 {
    let a: i32 = LIMIT;
    let b = -7;
    println(a, " ", b, " ", 10 / 3, " ", 10 % 3);
    let m: u8 = 255;
    let z: u8 = 0;
    println(m, " ", z, " ", 3 < 4, " ", 3 > 4);
    println(i32::MAX, " ", i32::MIN, " ", u64::MAX);
    let f = 1.5;
    println(f, " ", 1.5 * 2.0, " ", 0.1);
    println(fact(5), " ", 17 / 2 - 1, " ", -7 / 2);
    return 0;
}
