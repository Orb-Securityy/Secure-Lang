// EXPECT-OUT: 45 55 4950
// EXPECT-OUT: 1 3 5 7 9
// EXPECT-OUT: 256 255
// EXPECT-OUT: 3 3
fn main() -> i32 {
    let mut s = 0;
    for i in 0..10 { s += i; }
    let mut t = 0;
    for i in 1..=10 { t += i; }
    let mut w: u64 = 0;
    let mut k: u64 = 0;
    while k < 100 { w += k; k += 1; }
    println(s, " ", t, " ", w);
    for i in 0..10 { if i % 2 == 0 { continue; } print(i); if i < 9 { print(" "); } }
    println();
    let mut cnt = 0;
    for _x in 0..=255u8 { cnt += 1; }
    let mut hi: u8 = 0;
    for x in 250..=255u8 { hi = x; }
    println(cnt, " ", hi);
    let mut n = 0;
    let mut m = 0;
    loop { n += 1; if n > 2 { break; } }
    while n < 100 { m += 1; n += 1; if m == 3 { break; } }
    println(m, " ", 3);
    return 0;
}
