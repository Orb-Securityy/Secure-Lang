// EXPECT-OUT: 3 9 5 4 2 -4
// EXPECT-OUT: 1.4142135623730951 3 2.5 true
// EXPECT-OUT: Some2 None9 [3,2,1] ab!
// EXPECT-OUT: low low mid high 7
// EXPECT-OUT: made 11
/* block /* nested */ comment */
struct Counter { n: i32 }
impl Counter {
    fn new() -> Self { Self { n: 10 } }
    fn bump(&mut self) -> Self { self.n += 1; Self { n: self.n } }
}
fn bucket(x: i32) -> i32 { match x { 0 | 1 | 2 => 1, 3 | 4 => 2, _ => 3 } }
fn label(x: i32) -> bool { match x { 1 | 2 => true, _ => false } }
fn main() -> i32 {
    println(3.min(9), " ", 3.max(9), " ", 5i32.min(5), " ", (-4).abs(), " ", 2.pow(1u32), " ", -4);
    println(2.0.sqrt(), " ", 3.7.floor() as i32, " ", (-2.5).abs(), " ", 1.0 < 2.0);
    let mut v: Vec<i32> = Vec::new();
    v.push(1); v.push(2); v.push(3);
    v.swap(0, 2);
    let a = v.get(1);
    let b = v.get(5);
    match a { Some(x) => print("Some", x, " "), None => print("None ") }
    match b { Some(x) => print("Some", x, " "), None => print("None9 ") }
    print("[", v[0], ",", v[1], ",", v[2], "] ");
    let mut s = String::from("a");
    s.push('b');
    s.push(33u8);
    println(s);
    let r = [0, 1, 3, 9];
    println(if label(1) { "low" } else { "x" }, " ", if label(2) { "low" } else { "x" }, " ",
            if bucket(r[2]) == 2 { "mid" } else { "x" }, " ", if bucket(r[3]) == 3 { "high" } else { "x" }, " ", 7);
    let mut c = Counter::new();
    let d = c.bump();
    println("made ", d.n);
    if d.n == 11 { exit(0); }
    println("unreachable");
    return 1;
}
