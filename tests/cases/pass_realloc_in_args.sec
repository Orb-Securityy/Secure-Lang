// EXPECT-OUT: 5 3 4 3 true true
// EXPECT-OUT: 7
// receiver pointer must be formed AFTER args run: realloc inside arg must not dangle
struct Bag { items: Vec<String>, nums: Vec<i32> }
fn id_s(s: String) -> String { s }
fn grow(v: &mut Vec<i32>, x: i32) { v.push(x); }
fn main() -> i32 {
    let mut v: Vec<Vec<i32>> = Vec::new();
    v.push(Vec::new());
    v[0].push({ v.push(Vec::new()); v.push(Vec::new()); v.push(Vec::new()); v.push(Vec::new()); 5 });
    let idx: usize = 0;
    let mut nums: Vec<i32> = Vec::new();
    nums.push(1);
    grow(&mut nums, nums[idx]);
    grow(&mut nums, nums.len() as i32);
    // re-initialisation through a call that consumes and returns the same value
    let mut s = String::from("abc");
    s = id_s(s);
    s = id_s(s);
    // arrays of owned values (drop glue per element), nested owned containers
    let arr = [String::from("a"), String::from("bb"), String::from("ccc")];
    let mut vv: Vec<Vec<String>> = Vec::new();
    for i in 0..4 { let mut inner: Vec<String> = Vec::new(); for _j in 0..=i { inner.push(String::from("x")); } vv.push(inner); }
    let mut b = Bag { items: Vec::new(), nums: Vec::new() };
    b.items.push(String::from("k"));
    b.nums.push(9);
    let ob: Option<Bag> = Some(b);
    let o2: Option<Vec<i32>> = Some(nums);
    println(v.len(), " ", arr.len(), " ", vv.len(), " ", s.len(), " ", ob.is_some(), " ", o2.is_some());
    let r = if v.len() > 100 { make_len() } else { 7 };
    println(r);
    return 0;
}
fn make_len() -> usize { String::from("tmp").len() }
