// EXPECT-OUT: -128 32767 -2 -2
// EXPECT-OUT: -1 255 -1 18446744073709551615
fn add_i8(a: i8, b: i8) -> i8 { wrapping_add(a, b) }
fn sub_i16(a: i16, b: i16) -> i16 { wrapping_sub(a, b) }
fn mul_i32(a: i32, b: i32) -> i32 { wrapping_mul(a, b) }
fn mul_i64(a: i64, b: i64) -> i64 { wrapping_mul(a, b) }
fn cast_i8(value: u16) -> i8 { value as wrapping i8 }
fn cast_u8(value: i16) -> u8 { value as wrapping u8 }
fn cast_i64(value: u64) -> i64 { value as wrapping i64 }
fn cast_u64(value: i64) -> u64 { value as wrapping u64 }
fn main() -> i32 {
    println(
        add_i8(127i8, 1i8), " ",
        sub_i16(-32768i16, 1i16), " ",
        mul_i32(2147483647i32, 2i32), " ",
        mul_i64(9223372036854775807i64, 2i64)
    );
    println(
        cast_i8(255u16), " ",
        cast_u8(-1i16), " ",
        cast_i64(18446744073709551615u64), " ",
        cast_u64(-1i64)
    );
    return 0;
}
