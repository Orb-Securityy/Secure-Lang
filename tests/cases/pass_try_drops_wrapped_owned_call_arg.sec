// EXPECT-EXIT: 0
fn fail_arg() -> Result<i32, i32> {
    Err(7)
}

fn consume(value: Option<String>, number: i32) -> i32 {
    if value.is_some() {
        return number;
    }
    return 1;
}

fn work() -> Result<i32, i32> {
    Ok(consume(Some(String::from("wrapped-owned-argument")), fail_arg()?))
}

fn main() -> i32 {
    match work() {
        Ok(value) => { return value; },
        Err(_) => { return 0; },
    }
}
