// EXPECT-OUT: count 2
fn consume(s: &str, value: i32) -> i32 { value }
fn main() -> i32 {
    let mut count = 0;
    for i in 0..4 {
        consume(&String::from("iteration borrow"), {
            if i == 0 {
                count += 1;
                continue;
            }
            if i == 2 {
                break;
            }
            count += 1;
            i
        });
    }
    println("count ", count);
    return 0;
}
