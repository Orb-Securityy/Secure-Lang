// EXPECT-IN: 9223372036854775807
// EXPECT-IN: 1
// EXPECT-IN: -9223372036854775808
// EXPECT-IN: -9223372036854775809
// EXPECT-IN: 9223372036854775808
// EXPECT-IN: +7
// EXPECT-IN: -
// EXPECT-IN: 12x
// EXPECT-IN:
// EXPECT-IN:  5
// EXPECT-IN: 5 
// EXPECT-IN: 999999999999999999999999999999999999999999999999999999999999999999999999999999999999
// EXPECT-OUT: overflow detected: input ignored
// EXPECT-OUT: accepted=3 rejected=9 total=6
// Reads untrusted integers from stdin, one per line. Empty lines, malformed values,
// whitespace, and values outside the i64 range must be rejected without crashing.
// total uses checked arithmetic, so hostile input can never wrap around or corrupt memory.
enum Verdict { Accepted, Rejected, Overflow }

fn classify(line: &str, total: &mut i64) -> Verdict {
    match parse_i64(line) {
        None => Verdict::Rejected,
        Some(v) => match checked_add(*total, v) {
            None => Verdict::Overflow,
            Some(t) => { *total = t; Verdict::Accepted }
        },
    }
}

fn main() -> i32 {
    let mut total: i64 = 0;
    let mut accepted = 0;
    let mut rejected = 0;
    loop {
        let line = read_line();
        match line {
            None => break,
            Some(s) => {
                match classify(s.as_str(), &mut total) {
                    Verdict::Accepted => { accepted += 1; }
                    Verdict::Rejected => { rejected += 1; }
                    Verdict::Overflow => { println("overflow detected: input ignored"); rejected += 1; }
                }
            }
        }
    }
    println("accepted=", accepted, " rejected=", rejected, " total=", total);
    return 0;
}
