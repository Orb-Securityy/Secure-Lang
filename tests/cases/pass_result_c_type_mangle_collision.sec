struct A { x: i32 }
struct B_T_C { x: i32 }
struct A_T_B { x: i32 }
struct C { x: i32 }

fn first_result() -> Result<A, B_T_C> {
    Ok(A { x: 1 })
}

fn second_result() -> Result<A_T_B, C> {
    Ok(A_T_B { x: 2 })
}

fn main() -> i32 {
    let first = first_result();
    let second = second_result();
    let first_valid = match first {
        Ok(value) => value.x == 1,
        Err(_) => false,
    };
    let second_valid = match second {
        Ok(value) => value.x == 2,
        Err(_) => false,
    };
    if !first_valid {
        return 1;
    }
    if !second_valid {
        return 2;
    }
    return 0;
}
