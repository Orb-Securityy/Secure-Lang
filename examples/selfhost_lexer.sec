// Secure-written streaming lexer slice for the direct native backend.
// Reads source bytes from stdin and prints token kind + byte span.
// Token kinds: 1 identifier, 2 decimal integer, 3 quoted string,
// 4 printable ASCII punctuation, 90 lexical error, 0 end of input.

fn is_digit(value: i32) -> i32 {
    if value >= 48 {
        if value <= 57 { return 1; }
    }
    return 0;
}

fn is_letter(value: i32) -> i32 {
    if value == 95 { return 1; }
    if value >= 65 {
        if value <= 90 { return 1; }
    }
    if value >= 97 {
        if value <= 122 { return 1; }
    }
    return 0;
}

fn is_ident_continue(value: i32) -> i32 {
    if is_letter(value) == 1 { return 1; }
    if is_digit(value) == 1 { return 1; }
    return 0;
}

fn is_space(value: i32) -> i32 {
    if value == 32 { return 1; }
    if value == 9 { return 1; }
    if value == 10 { return 1; }
    if value == 13 { return 1; }
    return 0;
}

fn main() {
    let mut position: i32 = 0;
    let mut current: i32 = read_byte();

    while current != -1 {
        if is_space(current) == 1 {
            position += 1;
            current = read_byte();
        } else if is_letter(current) == 1 {
            let start: i32 = position;
            let mut length: i32 = 0;
            while is_ident_continue(current) == 1 {
                length += 1;
                position += 1;
                current = read_byte();
            }
            println(1, ":", start, ":", length);
        } else if is_digit(current) == 1 {
            let start: i32 = position;
            let mut length: i32 = 0;
            while is_digit(current) == 1 {
                length += 1;
                position += 1;
                current = read_byte();
            }
            println(2, ":", start, ":", length);
        } else if current == 34 {
            let start: i32 = position;
            let mut length: i32 = 1;
            let mut escaped: i32 = 0;
            let mut closed: i32 = 0;
            position += 1;
            current = read_byte();
            while current != -1 {
                if current == 10 {
                    closed = 2;
                    break;
                }
                if escaped == 1 {
                    escaped = 0;
                } else if current == 92 {
                    escaped = 1;
                } else if current == 34 {
                    closed = 1;
                }
                if closed == 1 {
                    length += 1;
                    position += 1;
                    current = read_byte();
                    break;
                } else {
                    length += 1;
                    position += 1;
                    current = read_byte();
                }
            }
            if closed == 1 {
                println(3, ":", start, ":", length);
            } else {
                println(90, ":", start, ":", length);
            }
        } else if current == 47 {
            let start: i32 = position;
            position += 1;
            current = read_byte();
            if current == 47 {
                position += 1;
                current = read_byte();
                while current != -1 {
                    if current == 10 { break; }
                    position += 1;
                    current = read_byte();
                }
            } else if current == 42 {
                let mut depth: i32 = 1;
                let mut previous: i32 = 0;
                position += 1;
                current = read_byte();
                while current != -1 {
                    if previous == 47 {
                        if current == 42 {
                            depth += 1;
                            previous = 0;
                        } else {
                            previous = current;
                        }
                    } else if previous == 42 {
                        if current == 47 {
                            depth -= 1;
                            previous = 0;
                        } else {
                            previous = current;
                        }
                    } else {
                        previous = current;
                    }
                    position += 1;
                    current = read_byte();
                    if depth == 0 { break; }
                }
                if depth != 0 {
                    println(90, ":", start, ":2");
                }
            } else {
                println(4, ":", start, ":1:47");
            }
        } else if current >= 32 {
            println(4, ":", position, ":1:", current);
            position += 1;
            current = read_byte();
        } else {
            println(90, ":", position, ":1");
            position += 1;
            current = read_byte();
        }
    }

    println(0, ":", position, ":0");
}
