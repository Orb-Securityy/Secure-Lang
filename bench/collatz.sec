fn steps(mut n: u64) -> u64 {
    let mut s: u64 = 0;
    while n != 1 {
        if n % 2 == 0 { n = n / 2; } else { n = 3 * n + 1; }
        s += 1;
    }
    s
}
fn main() -> i32 {
    let mut best: u64 = 0;
    let mut arg: u64 = 0;
    for i in 1..3000000u64 {
        let s = steps(i);
        if s > best { best = s; arg = i; }
    }
    println(arg, " ", best);
    return 0;
}
