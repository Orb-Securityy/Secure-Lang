fn main() -> i32 {
    let n: usize = 20000000;
    let mut sieve: Vec<bool> = Vec::new();
    for _i in 0..n + 1 { sieve.push(true); }
    sieve[0] = false;
    sieve[1] = false;
    let mut i: usize = 2;
    while i * i <= n {
        if sieve[i] {
            let mut j = i * i;
            while j <= n { sieve[j] = false; j += i; }
        }
        i += 1;
    }
    let mut count: u64 = 0;
    for k in 0..n + 1 { if sieve[k] { count += 1; } }
    println(count);
    return 0;
}
